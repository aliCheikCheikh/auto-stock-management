# Local development only. Copy to .env, then replace the blank values.
# Spring Boot does not load .env automatically; see DEVELOPMENT.md.
DB_USERNAME=auto_stock_user
DB_PASSWORD=
# Generate a signing key, for example: openssl rand -hex 32
JWT_SECRET=

# Optional: create an owner only when the user registry is empty.
INITIAL_OWNER_DISPLAY_NAME='Demo Owner'
INITIAL_OWNER_EMAIL=owner@example.test
# Use 8-72 characters; leave blank to skip owner creation.
INITIAL_OWNER_PASSWORD=
